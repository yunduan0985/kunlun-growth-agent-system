    res.json([
      { from_user: "张经理 (微信群: 昆仑增长2群)", content: "帅总，我们最近的小红书起号遇到了卡点，转化率突然从4%跌到了1%，这周有时间帮我们做个诊断吗？预算大概有2万左右。", timestamp: new Date(Date.now() - 600000).toISOString(), is_group: true },
