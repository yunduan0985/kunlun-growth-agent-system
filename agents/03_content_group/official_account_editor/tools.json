{
  "openapi": "3.0.0",
  "info": {
    "title": "微信排版编辑器辅助插件",
    "version": "1.2.0",
    "description": "提供给公众号排版编辑 Agent 进行 Markdown 渲染为内联 CSS 富文本 HTML、及草稿箱发布同步的 API 规范。"
  },
  "paths": {
    "/api/content/editor/render": {
      "post": {
        "summary": "将传入的 Markdown 原始文章转换并渲染为带有莫兰迪极简配色的内联 CSS 样式的微信富文本 HTML",
        "operationId": "renderWeChatHTML",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "markdown_content": { "type": "string", "description": "Markdown 格式正文内容" }
                },
                "required": ["markdown_content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTML 渲染成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "html_content": { "type": "string", "description": "带内联 CSS 样式的 HTML 正文" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/content/editor/publish": {
      "post": {
        "summary": "将排版渲染完毕的 HTML 格式文章一键推送到指定的微信公众号后台草稿箱中",
        "operationId": "publishWeChatDraft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string", "description": "文章标题" },
                  "html_content": { "type": "string", "description": "排版好的富文本 HTML" },
                  "author": { "type": "string", "default": "昆仑增长" }
                },
                "required": ["title", "html_content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "草稿推送成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "media_id": { "type": "string", "description": "微信草稿的唯一标识" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": { "type": "string", "description": "微信群聊ID或联系人微信号/备注" },
                  "content": { "type": "string", "description": "发送的文本内容" }
                },
                "required": ["to_username", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string", "description": "完整的终端命令" },
                  "cwd": { "type": "string", "description": "运行路径" }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    }
  }
}