{
  "openapi": "3.0.0",
  "info": {
    "title": "帅总知识库 RAG 检索插件",
    "version": "1.2.0",
    "description": "提供给知识库 Agent 进行本地向量数据库混合检索、相似度审计及引用文件查询的专用 API 规范。"
  },
  "paths": {
    "/api/knowledge/query": {
      "post": {
        "summary": "向私有知识库发起混合检索查询，召回高相似度文本段落",
        "operationId": "queryKnowledgeBase",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string", "description": "用户的提问关键词或问题描述" },
                  "top_k": { "type": "integer", "default": 5, "description": "召回的段落最大数量" }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "检索成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hits": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "document_name": { "type": "string", "description": "来源文档名称" },
                          "content": { "type": "string", "description": "参考文本片段" },
                          "score": { "type": "number", "description": "向量相似度得分 (0.0 - 1.0)" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/knowledge/document/list": {
      "get": {
        "summary": "获取当前知识库已挂载的参考资料和手册目录",
        "operationId": "listSourceDocuments",
        "responses": {
          "200": {
            "description": "返回文档清单",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "filename": { "type": "string" },
                      "file_size": { "type": "integer" },
                      "uploaded_time": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": { "type": "string", "description": "微信群聊ID或联系人微信号/备注" },
                  "content": { "type": "string", "description": "发送的文本内容" }
                },
                "required": ["to_username", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string", "description": "完整的终端命令" },
                  "cwd": { "type": "string", "description": "运行路径" }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    }
  }
}