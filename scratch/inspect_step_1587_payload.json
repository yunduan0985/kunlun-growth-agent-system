    async function loadPermissionMatrix() {
      try {
        const res = await fetch(`${getGatewayUrl()}/api/system/permissions`);
        const data = await res.json();
        if (data.success) {
          globalPermMatrix = data.matrix;
          applyRBACRules(); 
