{
  "openapi": "3.0.0",
  "info": {
    "title": "训练营手册编辑编译插件",
    "version": "1.2.0",
    "description": "提供给手册编辑 Agent 进行实操文档章节格式化、警告框嵌入及本地 Markdown 打包编译的 API 规范。"
  },
  "paths": {
    "/api/combat/manual/compile": {
      "post": {
        "summary": "传入零碎的 SOP 素材、附件链接和警告要点，自动打包生成排版严密的手册 Markdown 正文",
        "operationId": "compileManualChapter",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chapter_title": { "type": "string" },
                  "raw_sop_text": { "type": "string", "description": "杂乱的文章或代码素材" },
                  "warnings": { "type": "string", "description": "保姆级避坑提示" },
                  "attachment_links": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "配套的飞书/Github工具链接列表"
                  }
                },
                "required": ["chapter_title", "raw_sop_text"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "手册章节编译成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "compiled_markdown": { "type": "string", "description": "排版精美的手册正文" },
                    "save_path": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": { "type": "string", "description": "微信群聊ID或联系人微信号/备注" },
                  "content": { "type": "string", "description": "发送的文本内容" }
                },
                "required": ["to_username", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string", "description": "完整的终端命令" },
                  "cwd": { "type": "string", "description": "运行路径" }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    }
  }
}
