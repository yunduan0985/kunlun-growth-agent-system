- **微信渠道 (OpenClaw)**：当您部署在 Hermes 微信控制端或直接作为微信助手运行时，可调用 `/api/wechat/openclaw/send` 动作向群聊或私信发送通知、报表与指令。接收微信消息时，必须执行 PII 隐私信息掩码保护。
- **飞书 CLI (Lark CLI) 控制**：您可以通过调用 `/api/terminal/execute` 接口，运行以 `lark` 命名的飞书命令行程序，协助团队在 Mac 本地进行应用的部署、打包和数据表格备份。
- **Hermes 兼容**：确保所有输出符合 Hermes 格式标准。若执行长耗时任务，应先回传任务 ID 确认，待后台计算完毕后再次通过微信/飞书 API 进行异步投递。
"""

def upgrade_all_agents():
    agents_root = os.path.join(BASE_PATH, "agents")
    if not os.path.exists(agents_root):
        print("错误：未找到 agents 根目录。")
        return

    print("开始全局重构 30 个 Agent 的 tools.json 与 system_prompt.md...")

    count = 0
    for group_dir in os.listdir(agents_root):
        group_path = os.path.join(agents_root, group_dir)
        if not os.path.isdir(group_path):
            continue
            
        for agent_dir in os.listdir(group_path):
            agent_path = os.path.join(group_path, agent_dir)
            if not os.path.isdir(agent_path):
                continue
                
            # 1. 升级 tools.json
            tools_file = os.path.join(agent_path, "tools.json")
            if os.path.exists(tools_file):
                try:
                    with open(tools_file, 'r', encoding='utf-8') as f:
                        tools_data = json.load(f)
                    
                    # 确保 paths 存在
                    if "paths" not in tools_data:
                        tools_data["paths"] = {}
                        
                    # 注入微信 OpenClaw 与 终端/飞书 CLI 执行的通用 API 路由
                    tools_data["paths"]["/api/wechat/openclaw/send"] = COMMON_TOOLS_PATHS["/api/wechat/openclaw/send"]
                    tools_data["paths"]["/api/terminal/execute"] = COMMON_TOOLS_PATHS["/api/terminal/execute"]
                    
                    with open(tools_file, 'w', encoding='utf-8') as f:
                        json.dump(tools_data, f, ensure_ascii=False, indent=2)
                        
                except Exception as e:
                    print(f"警告：无法读取或写入 {tools_file} : {e}")

            # 2. 升级 system_prompt.md
            prompt_file = os.path.join(agent_path, "system_prompt.md")
            if os.path.exists(prompt_file):
                try:
                    with open(prompt_file, 'r', encoding='utf-8') as f:
                        content = f.read()
                    
                    # 检查是否已经注入过，防止重复追加
                    if "微信 / 飞书 CLI / Hermes 多平台接入规范" not in content:
                        # 在文件尾部追加通用规范
                        content = content.rstrip() + ADDITIONAL_PROMPT_INSTRUCTION
                        
                        with open(prompt_file, 'w', encoding='utf-8') as f:
                            f.write(content)
                except Exception as e:
                    print(f"警告：无法读取或写入 {prompt_file} : {e}")
                    
            count += 1
            
    print(f"成功重构并升级了 {count} 个 Agent，均已支持微信 OpenClaw、飞书 CLI 及 Hermes 控制协议。")

if __name__ == "__main__":
    upgrade_all_agents()
