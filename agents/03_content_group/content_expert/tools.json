{
  "openapi": "3.0.0",
  "info": {
    "title": "内容专家深度润色与核查插件",
    "version": "1.2.0",
    "description": "提供给内容专家 Agent 进行文章去AI感改写、辛辣金句提取及数据事实核对的 API 规范。"
  },
  "paths": {
    "/api/content/expert/polish": {
      "post": {
        "summary": "接收文章初稿，进行去 AI 味口语化改写、段落重组并自动提取爆款金句",
        "operationId": "polishContent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "raw_draft": { "type": "string", "description": "AI感较浓的文章初稿内容" }
                },
                "required": ["raw_draft"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "润色成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "polished_text": { "type": "string", "description": "降AI味改写后的地道推文" },
                    "golden_sentences": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "提取出的爆款金句列表"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/content/expert/verify": {
      "post": {
        "summary": "核对文案中引用的技术指标、企业数据（如ARR）、大佬发言事实等真伪",
        "operationId": "verifyFactData",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "claims": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "需要核实的事实或数据陈述列表"
                  }
                },
                "required": ["claims"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "事实核查完毕",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "verified": { "type": "boolean" },
                    "unverified_items": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": { "type": "string", "description": "微信群聊ID或联系人微信号/备注" },
                  "content": { "type": "string", "description": "发送的文本内容" }
                },
                "required": ["to_username", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string", "description": "完整的终端命令" },
                  "cwd": { "type": "string", "description": "运行路径" }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    }
  }
}