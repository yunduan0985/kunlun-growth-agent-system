    } catch (e) {
      console.error(`Failed to write default permissions file:`, e);
    }
    return res.json({ success: true, matrix: defaultMatrix });
  }

  try {
    const rawData = fs.readFileSync(permPath, 'utf-8');
    res.json({ success: true, matrix: JSON.parse(rawData) });
