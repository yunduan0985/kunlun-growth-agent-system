{
  "openapi": "3.0.0",
  "info": {
    "title": "内容生产官快速写作插件",
    "version": "1.2.0",
    "description": "提供给内容生产官 Agent 进行公众号、小红书及短视频双栏脚本初稿高产生成的 API 规范。"
  },
  "paths": {
    "/api/content/producer/write": {
      "post": {
        "summary": "根据输入的选题、受众画像及大纲素材，快速撰写出对应平台字数限制的初稿骨架",
        "operationId": "generateDraft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string", "description": "文章核心选题" },
                  "outline": { "type": "string", "description": "素材大纲或关键论点" },
                  "platform": { "type": "string", "enum": ["wechat", "xiaohongshu", "douyin"], "default": "wechat" }
                },
                "required": ["title", "outline"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "初稿生成成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "draft_content": { "type": "string", "description": "生成的原始文章或脚本内容" },
                    "estimated_words": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": { "type": "string", "description": "微信群聊ID或联系人微信号/备注" },
                  "content": { "type": "string", "description": "发送的文本内容" }
                },
                "required": ["to_username", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string", "description": "完整的终端命令" },
                  "cwd": { "type": "string", "description": "运行路径" }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    }
  }
}