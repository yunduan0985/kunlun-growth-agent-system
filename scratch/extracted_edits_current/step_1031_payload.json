('user-avatar-btn').style.display = 'flex';\n        // 同步角色选择器\n        const roleMap = { admin: 'admin', editor: 'editor', sales: 'sales' };\n        const sel = document.getElementById('user-role-select');\n        if (sel \u0026\u0026 roleMap[_currentUser.role]) sel.value = roleMap[_currentUser.role];\n      }\n","TargetFile":"/Volumes/MOVESPEED/下载/AIcode/Agent/index.html","toolAction":"Fixing enterApp role badge update","toolSummary":"Fix enterApp role"}Jreplace_file_content`