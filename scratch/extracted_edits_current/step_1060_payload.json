# 昆仑增长 Agent OS v2.0 — 完整配置文件
# 说明：本文件包含所有敏感凭证，请勿上传至 Git 仓库
# 已在 .gitignore 中排除本文件
# ============================================================

# --------- 基础配置 ---------
PORT=8888

# --------- 大模型密钥 (可在控制台「系统配置中心」可视化管理) ---------
# Anthropic Claude (官方 API)
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 聚合中转平台 (支持 OpenAI Compatible)
AGGREGATOR_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGGREGATOR_BASE_URL=https://api.example.com/v1

# --------- 飞书 (Lark) 配置 ---------
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 填写后即可启用飞书多维表格真实写入
LARK_TABLE_ID=

# --------- 微信集成 ---------
# 说明: 动态绑定本地解密 SQLite 数据库路径（可在配置中心「自动探测」）
WECHAT_DB_PATH=/Users/username/Library/Containers/com.tencent.xinWeChat/.../wx_db.db

# --------- WhatsApp 集成 (本地 Baileys 服务端口) ---------
WHATSAPP_API_URL=http://localhost:19000

# --------- X (Twitter) ---------
TWITTER_API_TOKEN=

# --------- 数据服务 ---------
TIANYANCHA_TOKEN=tyc_token_xxxxxxxxxxxxxxxxxxxxxxxxxx
OPENCLAW_API_URL=http://localhost:18000
