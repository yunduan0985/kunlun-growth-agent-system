{
  "openapi": "3.0.0",
  "info": {
    "title": "帅总商业决策辅助插件",
    "version": "1.2.0",
    "description": "提供给 AI帅总 Agent 进行工商天眼查审核、知识库向量检索及微信决策发布的一体化 API 规范。"
  },
  "paths": {
    "/api/knowledge/query": {
      "post": {
        "summary": "从帅总商业决策向量知识库中查询历史决策备忘录与冷启动商业规章",
        "operationId": "queryKnowledgeBase",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string", "description": "决策相关的查询问题" }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "查询成功并返回召回文本段"
          }
        }
      }
    },
    "/api/tianyancha/search": {
      "get": {
        "summary": "天眼查工商查询接口，核实拟合作方公司存续状态与工商执照信息",
        "operationId": "fetchTianyanchaInfo",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "企业名称关键字"
          }
        ],
        "responses": {
          "200": {
            "description": "工商检索完毕"
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": { "type": "string", "description": "微信群聊ID或联系人微信号/备注" },
                  "content": { "type": "string", "description": "发送的文本内容" }
                },
                "required": ["to_username", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string", "description": "完整的终端命令" },
                  "cwd": { "type": "string", "description": "运行路径" }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    }
  }
}