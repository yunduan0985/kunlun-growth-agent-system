      "ReplacementContent": "    async function loadAgentStatus() {\n      // 保持原有实现不变\n      try {\n        const res = await fetch(`${getGatewayUrl()}/api/system/agents/status`).then(r => r.json());\n        if (res.success) {\n          globalAgentStatus = res.status;\n          if (currentDept !== 'config' && currentDept !== 'chat') {\n            switchDepartment(currentDept, document.querySelector(`.sidebar .active`));\n          }\n        }\n      } catch (err) {\n        console.warn('[App] Load agent status failed', err);\n      }\n    }\n\n    // ==========================================\n    // 📚 多源知识库 Tab 切换逻辑\n    // ==========================================\n    function switchKbTab(tabId, btnElement) {\n      // 切换按钮样式\n      document.querySelectorAll('.kb-tab-btn').forEach(btn => {\n        btn.style.color = 'var(--text-muted)';\n        btn.style.background = 'none';\n        btn.classList.remove('active');\n      });\n      btnElement.style.color = 'var(--text-main)';\n      btnElement.style.background = 'rgba(0,0,0,0.05)';\n      btnElement.classList.add('active');\n\n      // 切换内容区\n      document.querySelectorAll('.kb-tab-content').forEach(content => {\n        content.style.display = 'none';\n      });\n      document.getElementById(`kb-tab-${tabId}`).style.display = 'block';\n    }\n\n    // 占位的保存方法，后续实现对接\n    function saveLarkKbConfig() { alert(\"飞书知识库配置已保存 (Mock)\"); }\n    function saveNotebookLmConfig() { alert(\"NotebookLM 配置已保存 (Mock)\"); }\n    function saveImaConfig() { alert(\"IMA 客户端配置已保存 (Mock)\"); }\n",
