{
  "openapi": "3.0.0",
  "info": {
    "title": "Agent 架构师辅助工具链",
    "version": "1.2.0",
    "description": "用于智能体架构拓扑生成、Mermaid 流程图编译、以及工作流 DSL 校验与导出的 API 集。"
  },
  "paths": {
    "/api/workflow/mermaid/render": {
      "post": {
        "summary": "将 Mermaid 文本编译渲染为可视化图片或 SVG 资源",
        "operationId": "renderMermaidDiagram",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mermaid_code": {
                    "type": "string",
                    "description": "标准的 Mermaid.js 流程图或状态图源码"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "svg",
                      "png"
                    ],
                    "default": "svg",
                    "description": "输出格式"
                  }
                },
                "required": [
                  "mermaid_code"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "编译渲染成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "image_url": {
                      "type": "string",
                      "description": "渲染后的图片托管 URL 或 Base64 编码"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/workflow/dsl/compile": {
      "post": {
        "summary": "将有向图拓扑配置编译生成为 Coze/Dify 官方支持一键导入的工作流 DSL JSON",
        "operationId": "compileTopologyToDsl",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "agent",
                            "tool",
                            "condition",
                            "start",
                            "end"
                          ]
                        }
                      }
                    }
                  },
                  "edges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string"
                        },
                        "target": {
                          "type": "string"
                        },
                        "condition": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "nodes",
                  "edges"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "DSL 转换成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dsl_json": {
                      "type": "object",
                      "description": "符合主流多智能体平台格式的 DSL 描述对象"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": {
                    "type": "string",
                    "description": "微信群聊ID或联系人微信号/备注"
                  },
                  "content": {
                    "type": "string",
                    "description": "发送的文本内容"
                  }
                },
                "required": [
                  "to_username",
                  "content"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "msgId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "description": "完整的终端命令"
                  },
                  "cwd": {
                    "type": "string",
                    "description": "运行路径"
                  }
                },
                "required": [
                  "command"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "stdout": {
                      "type": "string"
                    },
                    "stderr": {
                      "type": "string"
                    },
                    "exitCode": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}