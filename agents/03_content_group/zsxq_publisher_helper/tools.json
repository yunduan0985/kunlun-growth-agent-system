{
  "openapi": "3.0.0",
  "info": {
    "title": "知识星球自动发布插件",
    "version": "1.2.0",
    "description": "提供给知识星球发布助手 Agent 进行社群卡片一键发布、挂载附件及置顶设置的 API 规范。"
  },
  "paths": {
    "/api/content/zsxq/publish": {
      "post": {
        "summary": "将提炼完毕的极简干货卡片推送到知识星球对应的板块并设置置顶",
        "operationId": "publishToZsxq",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string", "description": "帖子标题" },
                  "content": { "type": "string", "description": "Markdown 格式干货卡片正文" },
                  "group_name": { "type": "string", "default": "昆仑增长主星球" },
                  "is_sticky": { "type": "boolean", "default": true, "description": "是否置顶该主题" }
                },
                "required": ["title", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "星球主题发布成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "topic_id": { "type": "string", "description": "知识星球主题贴ID" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": { "type": "string", "description": "微信群聊ID或联系人微信号/备注" },
                  "content": { "type": "string", "description": "发送的文本内容" }
                },
                "required": ["to_username", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string", "description": "完整的终端命令" },
                  "cwd": { "type": "string", "description": "运行路径" }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    }
  }
}