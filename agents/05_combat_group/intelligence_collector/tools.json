{
  "openapi": "3.0.0",
  "info": {
    "title": "情报搜集网页抓取插件",
    "version": "1.2.0",
    "description": "提供给情报收集者 Agent 进行竞品网页变化检测、更新日志爬取及定价变动解析的 API 规范。"
  },
  "paths": {
    "/api/combat/collector/scrape": {
      "post": {
        "summary": "传入目标竞品网址，抓取并分析其最新页面文本、更新日志及价格定价信息",
        "operationId": "scrapeTargetSite",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": { "type": "string", "description": "目标竞品主页或定价页 URL" }
                },
                "required": ["url"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "网页抓取并解析成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "site_title": { "type": "string" },
                    "pricing_plans": {
                      "type": "array",
                      "items": { "type": "object" }
                    },
                    "detected_changes": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": { "type": "string", "description": "微信群聊ID或联系人微信号/备注" },
                  "content": { "type": "string", "description": "发送的文本内容" }
                },
                "required": ["to_username", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string", "description": "完整的终端命令" },
                  "cwd": { "type": "string", "description": "运行路径" }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    }
  }
}
