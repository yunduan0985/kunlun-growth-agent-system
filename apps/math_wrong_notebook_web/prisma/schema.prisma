generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 机构/租户模型
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  
  users     User[]
  classes   Class[]
}

// 用户模型 (支持 RBAC: ADMIN / TEACHER / PARENT)
model User {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String   @unique
  role      String   @default("PARENT")
  createdAt DateTime @default(now())
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  classes   Class[]  @relation("TeacherClasses")
}

// 班级模型
model Class {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  teacherId String?
  createdAt DateTime @default(now())
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  teacher   User?    @relation("TeacherClasses", fields: [teacherId], references: [id])
  students  Student[]
}

// 学生模型
model Student {
  id        String   @id @default(uuid())
  classId   String
  name      String
  parentId  String? // 关联的家长 User.id
  
  class     Class    @relation(fields: [classId], references: [id])
  questions Question[]
}

// 错题模型
model Question {
  id          String   @id @default(uuid())
  studentId   String
  content     String   // 题目内容/OCR 文本
  imageUrl    String?  // 切题图像 URL
  isResolved  Boolean  @default(false)
  difficulty  String   @default("NORMAL")
  sourceId    String?  // RAG题库中原题的引用ID
  variantOf   String?  // 记录此题是否为某错题的变式题
  createdAt   DateTime @default(now())
  
  student     Student  @relation(fields: [studentId], references: [id])
}
