{
  "openapi": "3.0.0",
  "info": {
    "title": "AI 销冠私域成交转化插件",
    "version": "1.2.0",
    "description": "提供给 AI 销冠 Agent 进行微信聊天上下文 BANT 评级、价格异议分类及跟进话术智能推荐的 API 规范。"
  },
  "paths": {
    "/api/operation/sales/qualify": {
      "post": {
        "summary": "分析微信聊天对话上下文，提取出客户的预算、决策权、痛点需求及时间线指标，并生成推荐跟进话术",
        "operationId": "qualifySalesLead",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chat_history": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "微信聊天记录列表"
                  }
                },
                "required": ["chat_history"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "BANT 分析完毕",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "budget_confirmed": { "type": "boolean" },
                    "need_description": { "type": "string" },
                    "closing_rate": { "type": "number", "description": "预计成交概率 (0.0-1.0)" },
                    "recommended_script": { "type": "string", "description": "推荐的销售话术段落" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": { "type": "string", "description": "微信群聊ID或联系人微信号/备注" },
                  "content": { "type": "string", "description": "发送的文本内容" }
                },
                "required": ["to_username", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string", "description": "完整的终端命令" },
                  "cwd": { "type": "string", "description": "运行路径" }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    }
  }
}