echo " 🚀 昆仑增长 Agent OS v2.0"
echo "    启动端口: http://localhost:$PORT"
echo "=================================================="
echo ""
echo " ▶ 在浏览器中打开以下地址访问控制台："
echo "   👉 http://localhost:$PORT"
echo ""
echo " 按 Ctrl+C 关闭服务"
echo "--------------------------------------------------"

# 启动网关
node src/index.js
