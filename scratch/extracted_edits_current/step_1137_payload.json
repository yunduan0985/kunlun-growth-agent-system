zh58zhlmmulti_replace_file_contentJ{"Description":"Implementing SQLite FTS5 database for Local RAG. This includes initializing the DB, chunking text on upload/save, and inserting into the FTS5 virtual table.","Instruction":"1. Add RAG_DB_PATH and initialize SQLite FTS5 table `knowledge_chunks`.\n2. Update `/api/system/knowledge/save` to chunk and insert.\n3. Update `/api/system/knowledge/upload` to chunk and insert.\n4. Add `/api/system/knowledge/search` route for Agent to query.","ReplacementChunks":[{"AllowMultiple":false,"EndLine":48,"ReplacementContent":"const jwt = require('jsonwebtoken');\n\n// ==========================================\n// 核心路径与本地数据配置\n// ==========================================\nconst DATA_DIR = path.join(__dirname, '../data');\nif (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });\n\nconst DB_PATH = path.join(DATA_DIR, 'kunlun_agent.db'); // 暂未使用，保留扩展\nconst WX_DB_PATH = path.join(DATA_DIR, 'wx_mock.db'); // 用户可通过 UI 自定义覆盖\nconst KNOWLEDGE_DIR = path.join(DATA_DIR, 'knowledge');\nif (!fs.existsSync(KNOWLEDGE_DIR)) fs.mkdirSync(KNOWLEDGE_DIR, { recursive: true });\n\n// 📚 初始化 RAG SQLite FTS5 本地向量/全文检索库\nconst RAG_DB_PATH = path.join(DATA_DIR, 'rag_knowledge.db');\nconst ragDb = new sqlite3.Database(RAG_DB_PATH, (err) =\u003e {\n  if (err) console.error('[RAG Engine] Failed to open rag_knowledge.db', err);\n  else {\n    ragDb.run(`\n      CREATE VIRTUAL TABLE IF NOT EXISTS knowledge_chunks USING fts5(\n        filename, \n        chunk_index, \n        content,\n        tokenize='porter'\n      )\n    `);\n    console.log('[RAG Engine] FTS5 Knowledge Base Database initialized.');\n  }\n});\n\n// 分块函数 (Chunking) 供 RAG 入库使用\nfunction chunkText(text, chunkSize = 500, overlap = 100) {\n  const chunks = [];\n  let i = 0;\n  while (i \u003c text.length) {\n    chunks.push(text.slice(i, i + chunkSize));\n    i += (chunkSize - overlap);\n  }\n  return chunks;\n}\n\nconst JWT_SECRET_FILE = path.join(DATA_DIR, 'jwt_secret.txt');","StartLine":35,"TargetContent":"const jwt = require('jsonwebtoken');\n\n// 核心数据文件存储路径（生产环境为打包后的 userData 目录，此处为简化）\nconst DB_PATH = path.join(__dirname, '../data/kunlun_agent.db');\nconst WX_DB_PATH = path.join(__dirname, '../data/wx_mock.db'); // 用于 Mock 微信聊天记录的 DB\nconst JWT_SECRET_FILE = path.join(__dirname, '../data/jwt_secret.txt');"},{"AllowMultiple":false,"EndLine":2014,"ReplacementContent":"// 管理员持久化上传/保存知识库文档文件\napp.post('/api/system/knowledge/save', (req, res) =\u003e {\n  const { filename, content } = req.body;\n  const user_role = req.user?.role || 'sales'; // ✅ 从 JWT 读取，防止伪造\n  if (!filename || !content) return res.status(400).json({ error: \"Missing parameter: filename or content\" });\n\n  if (user_role !== 'admin') {\n    return res.status(403).json({ success: false, error: \"Access Denied: Only Admin can update knowledge base.\" });\n  }\n\n  const safeFilename = filename.endsWith('.txt') || filename.endsWith('.md') ? filename : filename + '.txt';\n  const targetPath = path.join(KNOWLEDGE_DIR, safeFilename);\n\n  console.log(`[RAG Engine] Writing knowledge base file to: ${targetPath}`);\n\n  try {\n    // 1. 保存物理文件\n    fs.writeFileSync(targetPath, content, 'utf-8');\n    \n    // 2. 切片并写入 FTS5 库\n    ragDb.run(`DELETE FROM knowledge_chunks WHERE filename = ?`, [safeFilename], (err) =\u003e {\n      if (err) console.error('[RAG Engine] Delete old chunks error:', err);\n      const chunks = chunkText(content);\n      const stmt = ragDb.prepare(`INSERT INTO knowledge_chunks (filename, chunk_index, content) VALUES (?, ?, ?)`);\n      chunks.forEach((chunk, index) =\u003e {\n        stmt.run(safeFilename, index, chunk);\n      });\n      stmt.finalize();\n      console.log(`[RAG Engine] Indexed ${chunks.length} chunks for ${safeFilename}`);\n    });\n\n    res.json({ success: true, message: `离线知识库文档「${safeFilename}」已物理持久化写入本地 FTS5 库，Agent 已实时挂载！` });\n  } catch (err) {\n    res.status(500).json({ error: \"Failed to write knowledge base file.\" });\n  }\n});","StartLine":1990,"TargetContent":"// 管理员持久化上传/保存知识库文档文件\napp.post('/api/system/knowledge/save', (req, res) =\u003e {\n  const { filename, content } = req.body;\n  const user_role = req.user?.role || 'sales';\n  if (!filename || !content) return res.status(400).json({ error: \"Missing parameter: filename or content\" });\n\n  if (user_role !== 'admin') {\n    return res.status(403).json({ success: false, error: \"Access Denied: Only Admin can update knowledge base.\" });\n  }\n\n  const knowledgeDir = path.join(__dirname, '../data/knowledge');\n  const safeFilename = filename.endsWith('.txt') || filename.endsWith('.md') ? filename : filename + '.txt';\n  const targetPath = path.join(knowledgeDir, safeFilename);\n\n  console.log(`[RAG Engine] Writing knowledge base file to: ${targetPath}`);\n\n  try {\n    const kDir = path.join(__dirname, '../data/knowledge');\n    if (!fs.existsSync(kDir)) fs.mkdirSync(kDir, { recursive: true });\n    fs.writeFileSync(targetPath, content, 'utf-8');\n    res.json({ success: true, message: `离线知识库文档「${safeFilename}」已物理持久化写入本地，Agent 已实时挂载！` });\n  } catch (err) {\n    res.status(500).json({ error: \"Failed to write knowledge base file.\" });\n  }\n});"},{"AllowMultiple":false,"EndLine":2069,"ReplacementContent":"    // 1. 写入物理文件\n    fs.writeFileSync(targetPath, extractedText.trim(), 'utf-8');\n\n    // 2. 切片并写入 FTS5 库\n    const finalFilename = targetFilename + '.txt';\n    ragDb.run(`DELETE FROM knowledge_chunks WHERE filename = ?`, [finalFilename], (err) =\u003e {\n      const chunks = chunkText(extractedText.trim());\n      const stmt = ragDb.prepare(`INSERT INTO knowledge_chunks (filename, chunk_index, content) VALUES (?, ?, ?)`);\n      chunks.forEach((chunk, index) =\u003e {\n        stmt.run(finalFilename, index, chunk);\n      });\n      stmt.finalize();\n      console.log(`[RAG Engine] Indexed ${chunks.length} chunks for ${finalFilename}`);\n    });\n\n    res.json({\n      success: true,\n      filename: finalFilename,\n      char_count: extractedText.length,\n      message: `「${req.file.originalname}」已成功解析并写入本地 FTS5 知识库，Agent 已实时挂载！`\n    });","StartLine":2058,"TargetContent":"    // 写入知识库\n    const kDir = path.join(__dirname, '../data/knowledge');\n    if (!fs.existsSync(kDir)) fs.mkdirSync(kDir, { recursive: true });\n    fs.writeFileSync(targetPath, extractedText.trim(), 'utf-8');\n\n    console.log(`[RAG Engine] File uploaded \u0026 indexed: ${targetFilename} (${extractedText.length} chars)`);\n    res.json({\n      success: true,\n      filename: targetFilename + '.txt',\n      char_count: extractedText.length,\n      message: `「${req.file.originalname}」已成功解析并写入本地知识库，Agent 已实时挂载！`\n    });"},{"AllowMultiple":false,"EndLine":2088,"ReplacementContent":"// 删除指定知识库文档\napp.delete('/api/system/knowledge/delete', (req, res) =\u003e {\n  const { filename } = req.body;\n  const user_role = req.user?.role || 'sales';\n  if (user_role !== 'admin') return res.status(403).json({ error: \"Access Denied.\" });\n\n  const targetPath = path.join(KNOWLEDGE_DIR, filename);\n  if (fs.existsSync(targetPath)) {\n    fs.unlinkSync(targetPath);\n    // 从 FTS5 删除\n    ragDb.run(`DELETE FROM knowledge_chunks WHERE filename = ?`, [filename]);\n    res.json({ success: true, message: 'Deleted.' });\n  } else {\n    res.status(404).json({ error: 'File not found.' });\n  }\n});\n\n// ==========================================\n// 🔍 RAG 搜索接口 (供 Agent 或测试使用)\n// ==========================================\napp.post('/api/system/knowledge/search', (req, res) =\u003e {\n  const { query, limit = 3 } = req.body;\n  if (!query) return res.status(400).json({ error: \"Missing query\" });\n\n  // FTS5 MATCH 语法：将查询按空格分词，构造 AND 查询\n  const ftsQuery = query.split(/\\\\s+/).map(q =\u003e `\"${q.replace(/\"/g, '')}\"`).join(' OR ');\n\n  ragDb.all(\n    `SELECT filename, chunk_index, content, rank \n     FROM knowledge_chunks \n     WHERE knowledge_chunks MATCH ? \n     ORDER BY rank \n     LIMIT ?`, \n    [ftsQuery, limit], \n    (err, rows) =\u003e {\n      if (err) {\n        console.error('[RAG Engine] Search error:', err);\n        return res.status(500).json({ error: \"Search failed\" });\n      }\n      res.json({ success: true, results: rows });\n    }\n  );\n});","StartLine":2079,"TargetContent":"// 删除指定知识库文档\napp.delete('/api/system/knowledge/delete', (req, res) =\u003e {\n  const { filename } = req.body;\n  const user_role = req.user?.role || 'sales';\n  if (user_role !== 'admin') return res.status(403).json({ error: \"Access Denied.\" });\n\n  const targetPath = path.join(__dirname, '../data/knowledge', filename);\n  if (fs.existsSync(targetPath)) {\n    fs.unlinkSync(targetPath);\n    res.json({ success: true, message: 'Deleted.' });\n  } else {\n    res.status(404).json({ error: 'File not found.' });\n  }\n});"}],"TargetFile":"/Volumes/MOVESPEED/下载/AIcode/Agent/src/index.js","toolAction":"Implementing SQLite FTS5 RAG chunking and searching API","toolSummary":"Implement SQLite FTS5 RAG"}:
