      `;
      container.appendChild(panel);
      
      loadSystemConfigInputs();
      loadLlmProviderInputs();
      renderPermissionTable();
      loadKnowledgeList(); // 载入离线 RAG 文档列表
      loadTokenUsagePanel(); // 载入 Token 账单
