{
  "openapi": "3.0.0",
  "info": {
    "title": "GitHub 开源情报尽调插件",
    "version": "1.2.0",
    "description": "提供给 GitHub 检索 Agent 进行仓库搜索、技术趋势分析及开源协议合规审计的 API 规范。"
  },
  "paths": {
    "/api/github/search/repositories": {
      "post": {
        "summary": "按关键字、开发语言和 Star 数量筛选符合要求的开源项目列表",
        "operationId": "searchGithubRepos",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string", "description": "搜索关键字" },
                  "language": { "type": "string", "description": "限定语言 (如 python, javascript)" },
                  "sort": { "type": "string", "enum": ["stars", "forks", "updated"], "default": "stars" }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "搜索成功"
          }
        }
      }
    },
    "/api/github/repo/detail": {
      "get": {
        "summary": "获取指定开源仓库的 Star/Fork 计数、最新提交时间及开源协议信息",
        "operationId": "getGithubRepoDetail",
        "parameters": [
          {
            "name": "repo_name",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "格式为 'owner/repo' 的项目全称"
          }
        ],
        "responses": {
          "200": {
            "description": "获取明细成功"
          }
        }
      }
    },
    "/api/github/trending": {
      "get": {
        "summary": "获取今日或本周 GitHub Trending 热门技术趋势库",
        "operationId": "getGithubTrending",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "指定编程语言"
          }
        ],
        "responses": {
          "200": {
            "description": "获取趋势列表成功"
          }
        }
      }
    },
    "/api/wechat/openclaw/send": {
      "post": {
        "summary": "微信 OpenClaw 控制接口：向微信群聊或联系人投递文本消息",
        "operationId": "openclawWechatSend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_username": { "type": "string", "description": "微信群聊ID或联系人微信号/备注" },
                  "content": { "type": "string", "description": "发送的文本内容" }
                },
                "required": ["to_username", "content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/api/terminal/execute": {
      "post": {
        "summary": "终端命令执行接口：运行安全的 Mac 本地 Shell 编译、打包指令或飞书 lark CLI、claude CLI 命令",
        "operationId": "executeTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string", "description": "完整的终端命令" },
                  "cwd": { "type": "string", "description": "运行路径" }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    }
  }
}