            <table class="perm-table">
              <thead>
                <tr>
                  <th>${dict.tbl_col_role}</th>
                  <th>${dict.tbl_col_wx}</th>
                  <th>${dict.tbl_col_risk}</th>
                  <th>${dict.tbl_col_config}</th>
