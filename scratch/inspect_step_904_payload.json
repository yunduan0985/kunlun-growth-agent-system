#toolu_vrtx_012rtqqaE6FypNzGR8XjCUdamulti_replace_file_content&{"Description":"修复两个关键 Bug：1) 用系统 node 二进制替代 Electron execPath 启动网关；2) 等待更长时间让网关完全就绪后再显示窗口；3) ready-to-show 注入端口改为 executeJavaScript 时序安全版本。","Instruction":"1. 查找系统 node 路径，用它替代 process.execPath 启动网关子进程。\n2. 等待时间从 2000ms 改为 3500ms（确保网关完全就绪）。\n3. executeJavaScript 添加 try-catch，避免 initGatewayUrl 未定义报错。","ReplacementChunks":[{"AllowMultiple":false,"EndLine":66,"ReplacementContent":"// 启动 Express 网关子进程\n// ==========================================\nfunction startGateway(port) {\n  // 确定 src/index.js 的正确路径（打包后在 resources/app/src/ 内）\n  const isDev = process.env.NODE_ENV === 'development' || !app.isPackaged;\n  const gatewayPath = isDev\n    ? path.join(__dirname, '../src/index.js')\n    : path.join(process.resourcesPath, 'app/src/index.js');\n\n  // ✅ 关键修复：必须使用系统 node，而非 process.execPath（Electron 二进制）\n  // 按优先级依次尝试常见 node 路径\n  const fs = require('fs');\n  const CANDIDATE_NODE_PATHS = [\n    '/opt/homebrew/bin/node',   // macOS Apple Silicon (Homebrew)\n    '/usr/local/bin/node',      // macOS Intel (Homebrew / nvm)\n    '/usr/bin/node',            // Linux\n    process.env.NODE_BINARY,   // 用户自定义（环境变量）\n    'node',                    // PATH 中的 node（兜底）\n  ].filter(Boolean);\n\n  let nodeExecutable = 'node'; // 默认兜底\n  for (const p of CANDIDATE_NODE_PATHS) {\n    if (p === 'node') { nodeExecutable = p; break; } // PATH 兜底，不用 existsSync 检查\n    if (fs.existsSync(p)) { nodeExecutable = p; break; }\n  }\n\n  console.log(`[Electron] Node binary: ${nodeExecutable}`);\n  console.log(`[Electron] Starting gateway on port ${port}, path: ${gatewayPath}`);\n\n  const env = Object.assign({}, process.env, {\n    PORT: String(port),\n    NODE_ENV: isDev ? 'development' : 'production'\n  });\n\n  gatewayProcess = spawn(nodeExecutable, [gatewayPath], {\n    env,\n    stdio: ['pipe', 'pipe', 'pipe']\n  });","StartLine":45,"TargetContent":"// 启动 Express 网关子进程\n// ==========================================\nfunction startGateway(port) {\n  // 确定 src/index.js 的正确路径（打包后在 resources/app/src/ 内）\n  const isDev = process.env.NODE_ENV === 'development' || !app.isPackaged;\n  const gatewayPath = isDev\n    ? path.join(__dirname, '../src/index.js')\n    : path.join(process.resourcesPath, 'app/src/index.js');\n\n  const nodeExecutable = process.execPath; // 使用 Electron 内置的 Node 运行时\n\n  console.log(`[Electron] Starting gateway on port ${port}, path: ${gatewayPath}`);\n\n  const env = Object.assign({}, process.env, {\n    PORT: String(port),\n    NODE_ENV: isDev ? 'development' : 'production'\n  });\n\n  gatewayProcess = spawn(process.execPath, [gatewayPath], {\n    env,\n    stdio: ['pipe', 'pipe', 'pipe']\n  });"},{"AllowMultiple":false,"EndLine":120,"ReplacementContent":"  // 3. 等待网关就绪（3.5 秒，给 node 子进程足够的启动时间）\n  await new Promise(r =\u003e setTimeout(r, 3500));","StartLine":117,"TargetContent":"  // 3. 等待网关就绪（最多 5 秒）\n  await new Promise(r =\u003e setTimeout(r, 2000));"},{"AllowMultiple":false,"EndLine":147,"ReplacementContent":"  // 6. 页面加载完成后显示窗口（苹果丝滑淡入）\n  mainWindow.once('ready-to-show', () =\u003e {\n    mainWindow.show();\n    // 通知前端使用正确的端口（延迟 500ms 确保 JS 上下文初始化完毕）\n    setTimeout(() =\u003e {\n      if (mainWindow \u0026\u0026 !mainWindow.isDestroyed()) {\n        mainWindow.webContents.executeJavaScript(\n          `try { \n            window.__GATEWAY_PORT__ = ${activePort}; \n            if(typeof window.initGatewayUrl === 'function') window.initGatewayUrl(${activePort});\n            console.log('[Electron IPC] Gateway port injected:', ${activePort});\n          } catch(e) { console.warn('initGatewayUrl not ready yet', e); }`\n        ).catch(e =\u003e console.error('[Electron] executeJavaScript error:', e));\n      }\n    }, 500);\n  });","StartLine":143,"TargetContent":"  // 6. 页面加载完成后显示窗口（苹果丝滑淡入）\n  mainWindow.once('ready-to-show', () =\u003e {\n    mainWindow.show();\n    // 通知前端使用正确的端口\n    mainWindow.webContents.executeJavaScript(\n      `window.__GATEWAY_PORT__ = ${activ